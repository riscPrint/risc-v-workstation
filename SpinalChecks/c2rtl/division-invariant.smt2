(set-logic QF_NIA)
(declare-const Q Int)(declare-const R Int)(declare-const D Int)
(declare-const digit Int)(declare-const next_digit Int)
; Prefix invariant: P = Q*D + R. A radix-4 step appends two bits.
(push)
(assert (not (= (+ (* (+ (* 4 Q) next_digit) D)
                       (- (+ (* 4 R) digit) (* next_digit D)))
                (+ (* 4 (+ (* Q D) R)) digit))))
(check-sat-using (then (using-params simplify :som true) smt))
(pop)
; Bounded prefix and nonzero divisor prevent quotient overflow.
(declare-const P Int)
(push)
(assert (and (<= 0 P) (< P 4294967296) (<= 0 Q) (<= 0 R) (<= 1 D)
             (= P (+ (* Q D) R))))
(assert (not (< Q 4294967296)))
(check-sat)
(pop)
; Uniqueness of quotient and remainder defines Euclidean division.
(declare-const Q2 Int)(declare-const R2 Int)
(push)
(assert (and (< 0 D) (<= 0 R) (< R D) (<= 0 R2) (< R2 D)
             (= (+ (* Q D) R) (+ (* Q2 D) R2))))
(assert (not (and (= Q Q2) (= R R2))))
(check-sat)
(pop)
; The transition equality is 34-bit. Both sides fit without wrap.
(declare-const T Int)(declare-const qdigit Int)(declare-const Rnext Int)
(push)
(assert (and (<= 1 D) (< D 4294967296) (<= 0 R) (< R D)
             (<= 0 T) (<= T 3) (<= 0 qdigit) (<= qdigit 3)
             (<= 0 Rnext) (< Rnext D)))
(assert (not (and (< (+ (* 4 R) T) 17179869184)
                  (< (+ Rnext (* qdigit D)) 17179869184))))
(check-sat)
(pop)
; Equality of residues is integer equality when neither side wraps.
(declare-const L Int)(declare-const H Int)
(push)
(assert (and (<= 0 L) (< L 17179869184) (<= 0 H) (< H 17179869184)
             (= (mod L 17179869184) (mod H 17179869184))))
(assert (not (= L H)))
(check-sat)
(pop)
; The four-bit counter supplies a decreasing rank until the last step.
(declare-const K Int)
(push)
(assert (and (<= 0 K) (< K 16)))
(assert (not (and (<= 1 (- 16 K)) (<= (- 16 K) 16)
                  (=> (< K 15) (and (= (- 16 (+ K 1)) (- (- 16 K) 1))
                                     (<= 1 (- 16 (+ K 1)))))
                  (=> (= K 15) (= (- 16 K) 1)))))
(check-sat)
(pop)
