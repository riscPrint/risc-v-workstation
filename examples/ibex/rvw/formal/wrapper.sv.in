module rvfi_wrapper(input clock, input reset, `RVFI_OUTPUTS);
wire ireq,dreq;
reg iv=0,dv=0;
(* anyseq *) reg [31:0] idata,ddata;
always @(posedge clock) begin
 if(reset) begin iv<=0;dv<=0;end
 else begin iv<=ireq;dv<=dreq;end
end
ibex_top dut(.clk_i(clock),.rst_ni(~reset),.scan_rst_ni(1'b1),.test_en_i(1'b1),
.ram_cfg_i('0),.hart_id_i(32'b0),.boot_addr_i(32'h80000000),.fetch_enable_i(4'd5),
.instr_req_o(ireq),.instr_gnt_i(1'b1),.instr_rvalid_i(iv),.instr_rdata_i(idata),.instr_err_i(1'b0),.instr_rdata_intg_i(7'b0),
.data_req_o(dreq),.data_gnt_i(1'b1),.data_rvalid_i(dv),.data_rdata_i(ddata),.data_err_i(1'b0),.data_rdata_intg_i(7'b0),
.irq_software_i(1'b0),.irq_timer_i(1'b0),.irq_external_i(1'b0),.irq_fast_i(15'b0),.irq_nm_i(1'b0),
.debug_req_i(1'b0),.scramble_key_valid_i(1'b0),.scramble_key_i('0),.scramble_nonce_i('0),
@RVFI_CONNECTIONS@);
endmodule
