{
  "contract": "constant-time",
  "clauses": ["pc", "memory", "branch"],
  "observations": ["cycles", "retire_cycles", "dbus_trace"],
  "public": {"reset": "cold"},
  "program": ["div x10, x6, x7", "divu x11, x6, x7", "rem x12, x6, x7", "remu x13, x6, x7",
              "mul x14, x6, x7", "mulh x15, x6, x7", "mulhu x16, x6, x7", "add x17, x10, x14"],
  "secrets": [{"x6": 7, "x7": 3}, {"x6": 2147483647, "x7": 1}],
  "minimize_runs": 16,
  "timeout": 1800,
  "adapter_command": ["{python}", "-m", "rvw.sec.core_adapter", "--binding", "core.json", "--template", "case.S", "{request}", "{out}"]
}
