{
  "isolation_kind": "register-state",
  "boundary": "U to M system call and back (mscratch secret)",
  "contract": "sandboxing",
  "clauses": [
    "pc",
    "memory",
    "branch"
  ],
  "observations": [
    "cycles",
    "retire_cycles",
    "tlb_events"
  ],
  "secrets": [
    {
      "t0": 3
    },
    {
      "t0": 1048575
    }
  ],
  "minimize_runs": 8,
  "timeout": 1800,
  "observer_mode": 0,
  "policy": {
    "denied_region": "M-mode scratch register and handler registers",
    "cleanup": "constant-time handler (xor/or/and), registers cleared"
  },
  "public": {
    "reset": "cold",
    "registers": {
      "a0": 0
    }
  },
  "program": [
    "addi a1, a0, 1",
    "ecall",
    "add a2, a1, a0",
    "ecall",
    "add a3, a2, a1"
  ],
  "adapter_command": [
    "{python}",
    "-m",
    "rvw.sec.core_adapter",
    "--binding",
    "core-su.json",
    "--template",
    "iso-um.S",
    "{request}",
    "{out}"
  ],
  "contract_start_pc": "0x80000100"
}
