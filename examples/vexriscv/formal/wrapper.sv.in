module rvfi_wrapper (
	input         clock,
	input         reset,
	`RVFI_OUTPUTS
);
	(* keep *) wire trap;


	(* keep *) wire        iBus_cmd_valid;
	(* keep *) wire [31:0] iBus_cmd_payload_pc;
	(* keep *) `rvformal_rand_reg iBus_cmd_ready;
	(* keep *) `rvformal_rand_reg iBus_rsp_ready;
	(* keep *) `rvformal_rand_reg [31:0] iBus_rsp_inst;


	(* keep *) wire  dBus_cmd_valid;
	(* keep *) wire  dBus_cmd_payload_wr;
	(* keep *) wire [31:0] dBus_cmd_payload_address;
	(* keep *) wire [31:0] dBus_cmd_payload_data;
	(* keep *) wire [1:0] dBus_cmd_payload_size;
	(* keep *) `rvformal_rand_reg dBus_cmd_ready;
	(* keep *) `rvformal_rand_reg    dBus_rsp_ready;
	(* keep *) `rvformal_rand_reg   [31:0] dBus_rsp_data;




	VexRiscv uut (
		.clk       (clock    ),
		.reset    (reset   ),

		.iBus_cmd_valid (iBus_cmd_valid),
		.iBus_cmd_ready (iBus_cmd_ready),
		.iBus_cmd_payload_pc  (iBus_cmd_payload_pc ),
		.iBus_rsp_valid(iBus_rsp_ready),
		.iBus_rsp_payload_inst(iBus_rsp_inst),
		.iBus_rsp_payload_error(1'b0),

		.dBus_cmd_valid(dBus_cmd_valid),
		.dBus_cmd_payload_wr(dBus_cmd_payload_wr),
		.dBus_cmd_payload_address(dBus_cmd_payload_address),
		.dBus_cmd_payload_data(dBus_cmd_payload_data),
		.dBus_cmd_payload_size(dBus_cmd_payload_size),
		.dBus_cmd_ready(dBus_cmd_ready),
		.dBus_rsp_ready(dBus_rsp_ready),
		.dBus_rsp_data(dBus_rsp_data),
		.dBus_rsp_error(1'b0),

		@RVFI_CONNECTIONS@
	);

`ifdef VEXRISCV_FAIRNESS
	// Simple buses return one in-order response per accepted fetch or load.
	// Stores have no response. Responses have at least one cycle of latency.
	// Eight bits cover all requests within the runner's maximum 200 cycles.
	(* keep *) reg [7:0] iBusOutstanding = 0;
	(* keep *) reg [7:0] dBusOutstanding = 0;
	(* keep *) reg [2:0] iBusCmdPendingCycles = 0;
	(* keep *) reg [2:0] iBusRspPendingCycles = 0;
	(* keep *) reg [2:0] dBusCmdPendingCycles = 0;
	(* keep *) reg [2:0] dBusRspPendingCycles = 0;
	wire iBusAccept = iBus_cmd_valid && iBus_cmd_ready;
	wire dBusLoadAccept = dBus_cmd_valid && dBus_cmd_ready && !dBus_cmd_payload_wr;
	always @(posedge clock) begin
		if (reset) begin
			assume (!iBus_rsp_ready && !dBus_rsp_ready);
			iBusOutstanding <= 0;
			dBusOutstanding <= 0;
			iBusCmdPendingCycles <= 0;
			iBusRspPendingCycles <= 0;
			dBusCmdPendingCycles <= 0;
			dBusRspPendingCycles <= 0;
		end else begin
			assume (!iBus_rsp_ready || iBusOutstanding != 0);
			assume (!dBus_rsp_ready || dBusOutstanding != 0);
			case ({iBusAccept, iBus_rsp_ready})
				2'b10: iBusOutstanding <= iBusOutstanding + 1;
				2'b01: iBusOutstanding <= iBusOutstanding - 1;
			endcase
			case ({dBusLoadAccept, dBus_rsp_ready})
				2'b10: dBusOutstanding <= dBusOutstanding + 1;
				2'b01: dBusOutstanding <= dBusOutstanding - 1;
			endcase
			// Each command stall and each gap between owed responses is bounded.
			iBusCmdPendingCycles <= iBus_cmd_valid && !iBus_cmd_ready ? iBusCmdPendingCycles + 1 : 0;
			dBusCmdPendingCycles <= dBus_cmd_valid && !dBus_cmd_ready ? dBusCmdPendingCycles + 1 : 0;
			iBusRspPendingCycles <= iBusOutstanding != 0 && !iBus_rsp_ready ? iBusRspPendingCycles + 1 : 0;
			dBusRspPendingCycles <= dBusOutstanding != 0 && !dBus_rsp_ready ? dBusRspPendingCycles + 1 : 0;
			assume (iBusCmdPendingCycles < 4 && dBusCmdPendingCycles < 4);
			assume (iBusRspPendingCycles < 4 && dBusRspPendingCycles < 4);
			// Keep the existing liveness scope: executions without traps.
			assume (!rvfi_trap);
		end
	end
`endif
endmodule
