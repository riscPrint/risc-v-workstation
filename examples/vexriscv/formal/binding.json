  "inputs": {
    "iBus_cmd_ready": 1,
    "iBus_rsp_valid": 1,
    "iBus_rsp_payload_inst": 32,
    "iBus_rsp_payload_error": 1,
    "dBus_cmd_ready": 1,
    "dBus_rsp_ready": 1,
    "dBus_rsp_data": 32,
    "dBus_rsp_error": 1
