  "outputs": {
    "iBus_cmd_valid": 1,
    "iBus_cmd_payload_pc": 32,
    "dBus_cmd_valid": 1,
    "dBus_cmd_payload_wr": 1,
    "dBus_cmd_payload_address": 32,
    "dBus_cmd_payload_data": 32,
    "dBus_cmd_payload_size": 2
  },
  "check_options": {
    "insn_add_ch0": {
      "engine": "abc bmc3"
    },
    "insn_addi_ch0": {
      "engine": "abc bmc3"
    }
  }
