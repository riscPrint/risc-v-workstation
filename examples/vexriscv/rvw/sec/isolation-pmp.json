{
  "isolation_kind": "pmp",
  "boundary": "M to U with PMP entry 0 denying the keystore region",
  "contract": "sandboxing",
  "clauses": [
    "pc",
    "memory",
    "branch"
  ],
  "observer_mode": 0,
  "contract_start_pc": "0x80000080",
  "policy": {
    "denied_region": "keystore 0x80008000+0x100 (pmpaddr0 NAPOT, no permissions)",
    "cleanup": "M handler skips the faulting load; no register holds the secret in U mode"
  },
  "observations": [
    "cycles",
    "retire_cycles",
    "dbus_trace",
    "bus_handshakes"
  ],
  "public": {
    "reset": "cold"
  },
  "program": [
    "li t1, 0x80008000",
    "la s1, sec_probe",
    "lw t0, 0(t1)",
    "andi t2, t0, 0x7c0",
    "add t2, s1, t2",
    "lw t3, 0(t2)"
  ],
  "secrets": [
    {
      "t0": 64
    },
    {
      "t0": 1024
    }
  ],
  "minimize_runs": 6,
  "timeout": 1800,
  "adapter_command": [
    "{python}",
    "-m",
    "rvw.sec.core_adapter",
    "--binding",
    "core-pmp.json",
    "--template",
    "pmp.S",
    "{request}",
    "{out}"
  ]
}
