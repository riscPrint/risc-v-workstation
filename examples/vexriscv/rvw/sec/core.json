{
  "schema": "rvw.sec-core/1",
  "name": "vexriscv",
  "rtl": [
    "${RVW_SEC_RTL}/vex/rv32im/VexTop.v"
  ],
  "top": "VexTop",
  "clock": "clk",
  "reset": "reset",
  "reset_cycles": 4,
  "ram": {
    "base": "0x80000000",
    "size": "0x10000"
  },
  "max_cycles": 50000,
  "platform": "../platform.json",
  "buses": [
    {
      "name": "ibus",
      "kind": "fetch",
      "latency": 1,
      "cmd_valid": "iBus_cmd_valid",
      "cmd_ready": "iBus_cmd_ready",
      "cmd_address": "iBus_cmd_payload_pc",
      "rsp_valid": "iBus_rsp_valid",
      "rsp_data": "iBus_rsp_payload_inst",
      "rsp_error": "iBus_rsp_payload_error"
    },
    {
      "name": "dbus",
      "kind": "data",
      "latency": 1,
      "write_response": false,
      "cmd_valid": "dBus_cmd_valid",
      "cmd_ready": "dBus_cmd_ready",
      "cmd_address": "dBus_cmd_payload_address",
      "cmd_write": "dBus_cmd_payload_wr",
      "cmd_data": "dBus_cmd_payload_data",
      "cmd_mask": "dBus_cmd_payload_mask",
      "rsp_valid": "dBus_rsp_ready",
      "rsp_data": "dBus_rsp_data",
      "rsp_error": "dBus_rsp_error"
    }
  ],
  "retire": {
    "kind": "rvfi",
    "prefix": "rvfi_"
  },
  "trap": {
    "valid": "trap_valid",
    "cause": "trap_cause",
    "tval": "trap_tval",
    "privilege": "CsrPlugin_privilege"
  },
  "probe_meta": {
    "branch:vex_static": {
      "semantics": "final-prediction"
    }
  }
}
