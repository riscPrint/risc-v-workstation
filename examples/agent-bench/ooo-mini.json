{
  "schema": "rvw.agent-native-tasks/1",
  "source": {
    "revision": "4a8757808d344f6db4660ce2e08ae88465f6e27a",
    "env": "OOO_MINI_SOURCE",
    "copy": [
      "examples/ooo-mini"
    ]
  },
  "adapter": "../ooo-mini/rvw/run.sh",
  "programs": "../ooo-mini/rvw/out/isa",
  "platform": "../ooo-mini/rvw/platform.json",
  "config": "default",
  "seed": 1,
  "nice": 15,
  "environment": {
    "RVW_OOO_LOCK": "vex-agentbench",
    "RVW_SBT_LOCK": "sbt-agentbench",
    "RVW_NICE": "15",
    "RISCVSIM_MAKE_JOBS": "2"
  },
  "run_args": [
    "--mem-latency",
    "0",
    "--max-cycles",
    "10000"
  ],
  "tasks": [
    {
      "id": "wakeup-race",
      "public": {
        "summary": "A mixed arithmetic workload can lose a wakeup. Find and repair the defect.",
        "failing": [
          "rv32um-p-mul"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "ready(dest(selected)) := True",
          "replace": "ready(dest(selected)) := !mulDiv.io.done"
        },
        "fail_to_pass": [
          "rv32um-p-mul"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "freelist-leak",
      "public": {
        "summary": "The rv32ui-p-add test can fail. Find and repair the core defect.",
        "failing": [
          "rv32ui-p-add"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "free := (free | releasedMask) & ~allocatedMask",
          "replace": "free := free & ~allocatedMask"
        },
        "fail_to_pass": [
          "rv32ui-p-add"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "recovery-map",
      "public": {
        "summary": "The rv32ui-p-beq test can fail. Find and repair the core defect.",
        "failing": [
          "rv32ui-p-beq"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "for (i <- 0 until 32) map(i) := recoveryMap(i)",
          "replace": "for (i <- 0 until 32) map(i) := U(i,tagWidth bits)"
        },
        "fail_to_pass": [
          "rv32ui-p-beq"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "store-age",
      "public": {
        "summary": "The rv32ui-p-lw test can fail. Find and repair the core defect.",
        "failing": [
          "rv32ui-p-lw"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "U(age,slotWidth bits) < selectAge && valid(s)",
          "replace": "U(age,slotWidth bits) > selectAge && valid(s)"
        },
        "fail_to_pass": [
          "rv32ui-p-lw"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "flush-valid",
      "public": {
        "summary": "The rv32ui-p-beq test can fail. Find and repair the core defect.",
        "failing": [
          "rv32ui-p-beq"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "valid(i) := False; done(i) := False; issued(i) := False",
          "replace": "valid(i) := valid(i); done(i) := False; issued(i) := False"
        },
        "fail_to_pass": [
          "rv32ui-p-beq"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "operand-ready",
      "public": {
        "summary": "The rv32ui-p-add test can fail. Find and repair the core defect.",
        "failing": [
          "rv32ui-p-add"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "valid(slot) && !issued(slot) && ready(src1(slot)) && ready(src2(slot)) &&",
          "replace": "valid(slot) && !issued(slot) && (ready(src1(slot)) || ready(src2(slot))) &&"
        },
        "fail_to_pass": [
          "rv32ui-p-add"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "rename-source",
      "public": {
        "summary": "The rv32ui-p-sub test can fail. Find and repair the core defect.",
        "failing": [
          "rv32ui-p-sub"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "src2(tail) := Mux(read2, map(instruction(24 downto 20).asUInt), U(0,tagWidth bits))",
          "replace": "src2(tail) := Mux(read2, map(instruction(19 downto 15).asUInt), U(0,tagWidth bits))"
        },
        "fail_to_pass": [
          "rv32ui-p-sub"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "mul-wakeup",
      "public": {
        "summary": "The rv32um-p-mul test can fail. Find and repair the core defect.",
        "failing": [
          "rv32um-p-mul"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "ready(dest(mdSlot)) := True",
          "replace": "ready(dest(mdSlot)) := False"
        },
        "fail_to_pass": [
          "rv32um-p-mul"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "mul-flush",
      "public": {
        "summary": "The rv32um-p-div test can fail. Find and repair the core defect.",
        "failing": [
          "rv32um-p-div"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "mulDiv.io.flush := redirect",
          "replace": "mulDiv.io.flush := False"
        },
        "fail_to_pass": [
          "rv32um-p-div"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    },
    {
      "id": "lsq-order",
      "public": {
        "summary": "The rv32ui-p-lw test can fail. Find and repair the core defect.",
        "failing": [
          "rv32ui-p-lw"
        ]
      },
      "private": {
        "mutation": {
          "file": "examples/ooo-mini/src/main/scala/ooomini/Core.scala",
          "find": "(!isLoad(slot) || !olderStorePending)",
          "replace": "(!isLoad(slot) || olderStorePending)"
        },
        "fail_to_pass": [
          "rv32ui-p-lw"
        ],
        "pass_to_pass": [
          "agent-control"
        ]
      }
    }
  ]
}
