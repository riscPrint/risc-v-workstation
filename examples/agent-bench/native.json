{
  "schema": "rvw.agent-native-tasks/1",
  "source": {
    "revision": "baf7dc82f855eddaf5b0a20a6802c526f127e38a",
    "env": "VEXRISCV",
    "copy": [
      "src"
    ]
  },
  "adapter": "../vexriscv/rvw/run.sh",
  "programs": "out/isa",
  "config": "rv32im",
  "seed": 1,
  "environment": {
    "RVW_VEX_LOCK": "vex-agentbench",
    "RVW_SBT_LOCK": "sbt-agentbench",
    "RVW_NICE": "15",
    "RISCVSIM_MAKE_JOBS": "2"
  },
  "run_args": [
    "--mem-latency",
    "0",
    "--max-cycles",
    "200000"
  ],
  "tasks": [
    {
      "id": "xor",
      "public": {
        "summary": "The xor ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-xor"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/IntAluPlugin.scala",
          "find": "AluBitwiseCtrlEnum.XOR  -> (input(SRC1) ^ input(SRC2))",
          "replace": "AluBitwiseCtrlEnum.XOR  -> (input(SRC1) | input(SRC2))",
          "occurrence": 1
        },
        "fail_to_pass": [
          "rv32ui-p-xor"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "or",
      "public": {
        "summary": "The or ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-or"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/IntAluPlugin.scala",
          "find": "AluBitwiseCtrlEnum.OR   -> (input(SRC1) | input(SRC2))",
          "replace": "AluBitwiseCtrlEnum.OR   -> (input(SRC1) & input(SRC2))",
          "occurrence": 1
        },
        "fail_to_pass": [
          "rv32ui-p-or"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "and",
      "public": {
        "summary": "The and ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-and"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/IntAluPlugin.scala",
          "find": "AluBitwiseCtrlEnum.AND  -> (input(SRC1) & input(SRC2))",
          "replace": "AluBitwiseCtrlEnum.AND  -> (input(SRC1) | input(SRC2))",
          "occurrence": 1
        },
        "fail_to_pass": [
          "rv32ui-p-and"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "sub",
      "public": {
        "summary": "The sub ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-sub"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/IntAluPlugin.scala",
          "find": "SUB  -> (nonImmediateActions ++ List(ALU_CTRL -> AluCtrlEnum.ADD_SUB,  SRC_USE_SUB_LESS -> True))",
          "replace": "SUB  -> (nonImmediateActions ++ List(ALU_CTRL -> AluCtrlEnum.ADD_SUB,  SRC_USE_SUB_LESS -> False))",
          "occurrence": 1
        },
        "fail_to_pass": [
          "rv32ui-p-sub"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "sltu",
      "public": {
        "summary": "The sltu ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-sltu"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/SrcPlugin.scala",
          "find": "Mux(input(SRC_LESS_UNSIGNED), input(SRC2).msb, input(SRC1).msb))",
          "replace": "Mux(input(SRC_LESS_UNSIGNED), input(SRC1).msb, input(SRC1).msb))",
          "occurrence": 2
        },
        "fail_to_pass": [
          "rv32ui-p-sltu"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "slt",
      "public": {
        "summary": "The slt ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-slt"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/IntAluPlugin.scala",
          "find": "SLT  -> (nonImmediateActions ++ List(ALU_CTRL -> AluCtrlEnum.SLT_SLTU, SRC_USE_SUB_LESS -> True, SRC_LESS_UNSIGNED -> False))",
          "replace": "SLT  -> (nonImmediateActions ++ List(ALU_CTRL -> AluCtrlEnum.SLT_SLTU, SRC_USE_SUB_LESS -> True, SRC_LESS_UNSIGNED -> True))",
          "occurrence": 1
        },
        "fail_to_pass": [
          "rv32ui-p-slt"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "bge",
      "public": {
        "summary": "The bge ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-bge"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/BranchPlugin.scala",
          "find": "B\"101\"  -> !less,",
          "replace": "B\"101\"  -> less,",
          "occurrence": 2
        },
        "fail_to_pass": [
          "rv32ui-p-bge"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "beq",
      "public": {
        "summary": "The beq ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-beq"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/BranchPlugin.scala",
          "find": "B\"000\"  -> eq  ,",
          "replace": "B\"000\"  -> !eq ,",
          "occurrence": 2
        },
        "fail_to_pass": [
          "rv32ui-p-beq"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "lb",
      "public": {
        "summary": "The lb ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-lb"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/DBusSimplePlugin.scala",
          "find": "(rspShifted(7) && !input(INSTRUCTION)(14))",
          "replace": "(rspShifted(7) && input(INSTRUCTION)(14))",
          "occurrence": 1
        },
        "fail_to_pass": [
          "rv32ui-p-lb"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    },
    {
      "id": "sra",
      "public": {
        "summary": "The sra ISA test fails. Find and repair the defect in the core sources.",
        "failing": [
          "rv32ui-p-sra"
        ]
      },
      "private": {
        "mutation": {
          "file": "src/main/scala/vexriscv/plugin/ShiftPlugins.scala",
          "find": "Cat(input(SHIFT_CTRL) === ShiftCtrlEnum.SRA & reversed.msb, reversed)",
          "replace": "Cat(False, reversed)",
          "occurrence": 1
        },
        "fail_to_pass": [
          "rv32ui-p-sra"
        ],
        "pass_to_pass": [
          "rv32ui-p-add",
          "rv32ui-p-sw"
        ]
      }
    }
  ],
  "project_copy": [
    {
      "source": "../vexriscv/.gitignore",
      "dest": ".gitignore"
    },
    {
      "source": "../vexriscv/rvw.toml",
      "dest": "rvw.toml"
    },
    {
      "source": "../vexriscv/rvw",
      "dest": "rvw"
    }
  ],
  "project_mutations": [
    {
      "file": "rvw.toml",
      "find": "lock = \"vex\"",
      "replace": "lock = \"vex-agentbench\""
    }
  ],
  "program_copy": [
    {
      "source": "out/isa",
      "dest": "rvw/out/isa"
    }
  ],
  "platform": "../vexriscv/rvw/platform.json",
  "nice": 15
}
