{
  "schema": "rvw.soc-compose/1",
  "map": "soc.json",
  "core": {
    "class": "examplesocvex.VexCore",
    "bus": "axi4"
  },
  "clock_hz": 50000000,
  "reset": "async_high",
  "devices": {
    "ram": {
      "type": "ram"
    },
    "uart": {
      "type": "project",
      "class": "rvwsoc.Uart16550",
      "exports": [
        "serial"
      ]
    },
    "clint": {
      "type": "project",
      "class": "rvwsoc.Clint",
      "domain": "slow"
    },
    "plic": {
      "type": "project",
      "class": "rvwsoc.Plic",
      "exports": [
        "sources"
      ]
    },
    "finisher": {
      "type": "project",
      "class": "rvwsoc.Finisher"
    }
  },
  "domains": {
    "slow": {
      "clock_hz": 10000000,
      "reset": "async_high"
    }
  }
}
