{
  "schema": "rvw.soc-verify/1",
  "checks": {
    "protocol": {
      "capture": "{out}/native/apb.jsonl",
      "composition": "compose.json"
    },
    "registers": {
      "capture": "{out}/native/apb.jsonl"
    },
    "vip": {
      "capture": "{out}/native/apb.jsonl"
    },
    "decode": {
      "classpath_file": "../../out/vex-cp.txt"
    },
    "uvm": {
      "composition": "compose.json",
      "classpath_file": "../../out/vex-cp.txt",
      "build_args": [
        "-Drvw.soc.vex=true"
      ],
      "idle_inputs": {
        "uart_serial_rxd": 1,
        "plic_sources": 0
      }
    },
    "connectivity": {
      "database": "{out}/single/soc.db",
      "manifest": "connections.json"
    },
    "cdc_rdc": {
      "database": "{out}/multi/soc.db"
    }
  },
  "prepare_steps": [
    [
      "../../../rvw/.venv/bin/python",
      "prepare-verify.py",
      "{out}",
      "single"
    ],
    [
      "../../../rvw/.venv/bin/python",
      "prepare-verify.py",
      "{out}",
      "multi"
    ],
    [
      "bash",
      "run.sh",
      "run",
      "--elf",
      "../../programs/vex/verify",
      "--out",
      "{out}/native",
      "--seed",
      "31",
      "--max-cycles",
      "40000"
    ]
  ]
}
