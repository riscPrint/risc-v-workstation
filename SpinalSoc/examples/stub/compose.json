{
  "schema": "rvw.soc-compose/1",
  "map": "soc.json",
  "core": {
    "class": "example.Stub",
    "bus": "apb3"
  },
  "clock_hz": 50000000,
  "reset": "sync_high",
  "devices": {
    "ram": {
      "type": "ram"
    },
    "uart": {
      "type": "project",
      "class": "rvwsoc.Uart16550",
      "exports": [
        "serial"
      ]
    },
    "clint": {
      "type": "project",
      "class": "rvwsoc.Clint"
    },
    "plic": {
      "type": "project",
      "class": "rvwsoc.Plic",
      "exports": [
        "sources"
      ]
    },
    "finisher": {
      "type": "project",
      "class": "rvwsoc.Finisher"
    }
  }
}
