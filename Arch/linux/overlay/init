#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t devtmpfs devtmpfs /dev || exit 1
mount -t proc proc /proc || exit 1
mount -t sysfs sysfs /sys || exit 1
# Run a separate user process. This is a small userspace check, not a selftest suite.
/bin/sh -c 'test "$(cat /proc/sys/kernel/ostype)" = Linux' || exit 1
echo RVW_LINUX_USERSPACE_OK
sync
poweroff -f
