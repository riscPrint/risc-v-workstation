    {
      "id": "add-coverage",
      "title": "Add coverage",
      "when": "Tests pass, and the next question is what they do not exercise.",
      "steps": [
        {
          "id": "run",
          "do": "Run the suite with coverage collection.",
          "cli": [
            "regress",
            "run",
            "--tier",
            "full",
            "--rvfi-trace",
            "--out",
            "<RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_run"
          },
          "decide": [
            {
              "if": "runs complete",
              "then": "functional"
            }
          ]
        },
        {
          "id": "functional",
          "do": "Measure instruction and event coverage from the C2 traces.",
          "cli": [
            "cov",
            "functional",
            "<RUN>",
            "--json",
            "--out",
            "<COV>"
          ],
          "mcp": {
            "tool": "cov_functional"
          },
          "decide": [
            {
              "if": "holes listed",
              "then": "merge"
            }
          ]
        },
        {
          "id": "merge",
          "do": "Merge Verilator coverage into one database.",
          "cli": [
            "cov",
            "merge",
            "<RUN>"
          ],
          "mcp": {
            "tool": "cov_merge"
          },
          "decide": [
            {
              "if": "a database",
              "then": "report"
            }
          ]
        },
        {
          "id": "report",
          "do": "Report RTL holes against Scala source lines.",
          "cli": [
            "cov",
            "report",
            "<COVDB>"
          ],
          "mcp": {
            "tool": "cov_report"
          },
          "decide": [
            {
              "if": "holes",
              "then": "rank"
            }
          ]
        },
        {
          "id": "rank",
          "do": "Rank tests by unique contribution.",
          "cli": [
            "cov",
            "rank",
            "<COVDB>",
            "--json"
          ],
          "mcp": {
            "tool": "cov_rank"
          },
          "decide": [
            {
              "if": "holes remain",
              "then": "closure"
            }
          ]
        },
        {
          "id": "closure",
          "do": "Select generated candidates that close holes, then add them as tests.",
          "cli": [
            "cov",
            "closure",
            "<COVDB>",
            "--candidates",
            "<CANDIDATES>"
          ],
          "mcp": {
            "tool": "cov_closure"
          },
          "decide": [
            {
              "if": "new tests added",
              "then": "run"
            },
            {
              "if": "no candidate closes a hole",
              "then": "done"
            }
          ]
        }
      ],
