    {
      "id": "prove-property",
      "title": "Prove a property",
      "when": "A rule must hold for all inputs within a bound, not only for the tests.",
      "steps": [
        {
          "id": "doctor",
          "do": "Check the formal tools.",
          "cli": [
            "formal",
            "doctor",
            "--out",
            "<OUT>",
            "--json"
          ],
          "mcp": {
            "tool": "formal_doctor"
          },
          "decide": [
            {
              "if": "a solver is missing",
              "then": "stop",
              "note": "Install with scripts/install.sh --with-formal."
            },
            {
              "if": "ready",
              "then": "bmc"
            }
          ]
        },
        {
          "id": "bmc",
          "do": "Run bounded model checking on the generated or declared checks.",
          "cli": [
            "formal",
            "bmc",
            "--out",
            "<OUT>",
            "--depth",
            "20",
            "--json"
          ],
          "mcp": {
            "tool": "formal_bmc"
          },
          "decide": [
            {
              "if": "fail",
              "then": "cex"
            },
            {
              "if": "timeout or unknown (exit 3)",
              "then": "stop",
              "note": "Bounded and inconclusive. Not a proof."
            },
            {
              "if": "pass",
              "then": "riscv"
            }
          ]
        },
        {
          "id": "riscv",
          "do": "Optional: run the declared ISA kit. Mapped single-bus Spinal RV32 init supplies the wrapper. Run smoke with --rvfi-trace, then formal isa --trace RUN/rvfi.jsonl. Review latency_measurement, memory assumptions and per-check actions. Exact instruction cycles can need check_options.cycles. Timeouts and machine-state gaps remain inconclusive.",
          "cli": [
            "formal",
            "isa",
            "--trace",
            "<TRACE>",
            "--out",
            "<OUT>",
            "--json"
          ],
          "mcp": {
            "tool": "formal_isa"
          },
          "optional": true,
          "decide": [
            {
              "if": "fail",
              "then": "cex"
            },
            {
              "if": "pass",
              "then": "done",
              "note": "A bounded pass is not a full ISA proof."
            }
          ]
        },
        {
          "id": "cex",
          "do": "Explain the counterexample and replay it in simulation.",
          "cli": [
