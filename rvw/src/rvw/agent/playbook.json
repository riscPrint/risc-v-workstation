{
  "schema": "rvw.agent-guide/1",
  "conventions": {
    "placeholders": "Angle-bracket values (<ELF>, <RUN>, <REV>) are inputs the agent supplies. Every other argument is literal.",
    "exit_codes": "0 earned result; 1 failure or mismatch; 2 usage or setup error; 3 inconclusive. Never treat 3 as a pass.",
    "stop": "A step ends a workflow with `stop` when its decision says so. Record the command, exit code and log before you stop.",
    "locks": "Heavy runs hold the project lock (core.lock). Do not start a second heavy run of the same core.",
    "integration_guide": "Follow docs/INTEGRATION_GUIDE.md for install, project binding and evidence limits. A scaffold or tool list does not qualify a core."
  },
  "workflows": [
    {
      "id": "bring-up",
      "title": "New core bring-up",
      "when": "A Spinal core repository has no rvw.toml yet, or `rvw doctor` is not ready.",
      "steps": [
        {
          "id": "doctor",
          "do": "Check the installation and the native tools.",
          "cli": [
            "doctor",
            "--features",
            "sim,riscv-gcc,cosim",
            "--json"
          ],
          "mcp": {
            "tool": "rvw_doctor"
          },
          "decide": [
            {
              "if": "exit 1 and a native tool is missing",
              "then": "install"
            },
            {
              "if": "project missing",
              "then": "init-plan"
            },
            {
              "if": "exit 0",
              "then": "regress-list"
            }
          ]
        },
        {
          "id": "install",
          "do": "Inspect the installer actions, then run them without --dry-run.",
          "cli": [
            "doctor",
            "--install",
            "sim,riscv-gcc,cosim",
            "--dry-run",
            "--json"
          ],
          "decide": [
            {
              "if": "the plan is acceptable",
              "then": "doctor"
            }
          ]
        },
        {
          "id": "init-plan",
          "do": "Plan the project files. Read every planned file.",
          "cli": [
            "init",
            "--isa",
            "<ISA>",
            "--wire-build",
            "--dry-run",
            "--json"
          ],
          "decide": [
            {
              "if": "exit 2",
              "then": "stop",
              "note": "Fix the reported input (ISA, sbt project, linker script)."
            },
            {
              "if": "exit 0",
              "then": "init"
            }
          ]
        },
        {
          "id": "init",
          "do": "Write rvw.toml, rvw/run.sh, the adapter skeleton and the core playbook.",
          "cli": [
            "init",
            "--isa",
            "<ISA>",
            "--wire-build",
            "--json"
          ],
          "decide": [
            {
              "if": "exit 0",
              "then": "map-adapter"
            }
          ]
        },
        {
          "id": "map-adapter",
          "do": "Map clock, reset, accepted memory transactions, completion and committed RVFI fields in the core adapter. Follow docs/INTEGRATION_GUIDE.md sections 2 to 4. Review the ISA and memory map. Build a smoke ELF.",
          "manual": true,
          "decide": [
            {
              "if": "the adapter compiles",
              "then": "smoke"
            }
          ]
        },
        {
          "id": "smoke",
          "do": "Build the model and run one ELF through C1.",
          "cli": [
            "doctor",
            "--smoke-elf",
            "<ELF>",
            "--smoke-options",
            "rvfi",
            "--json"
          ],
          "mcp": {
            "tool": "rvw_doctor",
            "arguments": {
              "smoke_elf": "<ELF>"
            }
          },
          "decide": [
            {
              "if": "smoke run fails",
              "then": "test-fails"
            },
            {
              "if": "smoke run passes",
              "then": "regress-list"
            }
          ]
        },
        {
          "id": "regress-list",
          "do": "List the suites and tests the project declares.",
          "cli": [
            "regress",
            "list",
            "--json"
          ],
          "mcp": {
            "tool": "regress_list"
          },
          "decide": [
            {
              "if": "no tests",
              "then": "stop",
              "note": "Build the test ELFs (AGENT_SETUP.md step 6)."
            },
            {
              "if": "tests listed",
              "then": "quick"
            }
          ]
        },
        {
          "id": "quick",
          "do": "Run the quick tier with C2 traces.",
          "cli": [
            "regress",
            "run",
            "--tier",
            "quick",
            "--rvfi-trace",
            "--out",
            "<RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_run"
          },
          "decide": [
            {
              "if": "a test fails",
              "then": "test-fails"
            },
            {
              "if": "all pass",
              "then": "cosim"
            }
          ]
        },
        {
          "id": "cosim",
          "do": "Compare one passing C2 trace with Spike.",
          "cli": [
            "cosim",
            "check",
            "--elf",
            "<ELF>",
            "--trace",
            "<RUN>/rvfi.jsonl",
            "--json"
          ],
          "mcp": {
            "tool": "cosim_check"
          },
          "decide": [
            {
              "if": "mismatch",
              "then": "test-fails"
            },
            {
              "if": "match",
              "then": "gate"
            }
          ]
        },
        {
          "id": "gate",
          "do": "Commit the project files, then judge the committed revision.",
          "cli": [
            "regress",
            "gate",
            "--tier",
            "quick",
            "--base-rev",
            "<REV>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_gate"
          },
          "decide": [
            {
              "if": "NOT ACCEPTED on a dirty tree",
              "then": "gate",
              "note": "Commit first. A dirty tree cannot earn accept."
            },
            {
              "if": "inconclusive (exit 3)",
              "then": "stop",
              "note": "Missing evidence. Do not report acceptance."
            },
            {
              "if": "accept",
              "then": "design-db"
            }
          ]
        },
        {
          "id": "design-db",
          "do": "Build the design database for design questions.",
          "cli": [
            "query",
            "build",
            "--json"
          ],
          "mcp": {
            "tool": "query_build_db"
          },
          "decide": [
            {
              "if": "exit 0",
              "then": "done"
            }
          ]
        }
      ]
    },
    {
      "id": "test-fails",
      "title": "A test fails",
      "when": "A C1 run or a regression test reports fail, assert, timeout or rvfi_error.",
      "steps": [
        {
          "id": "identity",
          "do": "Check the source revision, RTL hash, ELF hash, config and seed of the failing run and each cited artifact. Reject stale waves, wrong ELFs and incomplete runs before cause analysis.",
          "manual": true,
          "decide": [
            {
              "if": "identities match and the failure is reproduced",
              "then": "bundle"
            },
            {
              "if": "evidence is missing or inconsistent",
              "then": "stop",
              "note": "Record the missing evidence. Do not claim a cause or fix."
            }
          ]
        },
        {
          "id": "bundle",
          "do": "Write the failure report from the failed run directory.",
          "cli": [
            "bundle",
            "<RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "bundle_make"
          },
          "decide": [
            {
              "if": "the bundle has a C2 trace",
              "then": "cosim"
            },
            {
              "if": "no C2 trace",
              "then": "stop",
              "note": "Rerun the test with --rvfi-trace."
            }
          ]
        },
        {
          "id": "cosim",
          "do": "Find the first instruction where the core and Spike differ.",
          "cli": [
            "cosim",
            "check",
            "--elf",
            "<ELF>",
            "--trace",
            "<RUN>/rvfi.jsonl",
            "--json"
          ],
          "mcp": {
            "tool": "cosim_check"
          },
          "decide": [
            {
              "if": "mismatch at a retirement",
              "then": "known-bug"
            },
            {
              "if": "match but the run failed",
              "then": "wave",
              "note": "The failure is not architectural: look at the end condition, hang or assertion."
            }
          ]
        },
        {
          "id": "known-bug",
          "do": "Compare the failure signature with stored bug patterns.",
          "cli": [
            "bugmem",
            "match",
            "<BUNDLE>/report.json"
          ],
          "mcp": {
            "tool": "bugmem_match"
          },
          "decide": [
            {
              "if": "a high score",
              "then": "drivers",
              "note": "Check the stored root cause first."
            },
            {
              "if": "no match",
              "then": "drivers"
            }
          ]
        },
        {
          "id": "drivers",
          "do": "Ask what drives the wrong register or signal.",
          "cli": [
            "query",
            "drivers",
            "<SIGNAL>",
            "--json"
          ],
          "mcp": {
            "tool": "query_drivers"
          },
          "decide": [
            {
              "if": "the driver logic is clear",
              "then": "wave"
            }
          ]
        },
        {
          "id": "wave",
          "do": "Explain the wrong value at the failing cycle.",
          "cli": [
            "wave",
            "why",
            "<WAVE>",
            "<SIGNAL>",
            "--at",
            "<TIME>",
            "--json"
          ],
          "mcp": {
            "tool": "wave_why"
          },
          "decide": [
            {
              "if": "the cause is a Scala statement",
              "then": "fix"
            },
            {
              "if": "no observed statement explains the value",
              "then": "stop",
              "note": "Keep the cause unknown. Static drivers alone do not prove a dynamic cause."
            }
          ]
        },
        {
          "id": "fix",
          "do": "Edit the core. Keep the change small. Do not edit the workstation.",
          "manual": true,
          "decide": [
            {
              "if": "edited",
              "then": "reproduce"
            }
          ]
        },
        {
          "id": "reproduce",
          "do": "Rerun the failing test and the required passing tests with the repair. Use a new output directory. Keep all results.",
          "cli": [
            "regress",
            "run",
            "--tier",
            "quick",
            "--rvfi-trace",
            "--out",
            "<REPAIRED_RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_run"
          },
          "decide": [
            {
              "if": "the failing test passes and the required passing tests stay passing",
              "then": "gate"
            },
            {
              "if": "a test fails",
              "then": "bundle"
            },
            {
              "if": "coverage is incomplete",
              "then": "stop",
              "note": "Do not report a repair."
            }
          ]
        },
        {
          "id": "gate",
          "do": "Judge the fix on the committed revision.",
          "cli": [
            "regress",
            "gate",
            "--tier",
            "quick",
            "--base-rev",
            "<REV>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_gate"
          },
          "decide": [
            {
              "if": "reject",
              "then": "bundle"
            },
            {
              "if": "inconclusive (exit 3)",
              "then": "stop",
              "note": "Do not claim a fix."
            },
            {
              "if": "accept",
              "then": "done"
            }
          ]
        },
        {
          "id": "reduce",
          "do": "Optional: shrink a long failing program before debugging.",
          "cli": [
            "reduce",
            "<RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "reduce_run"
          },
          "optional": true,
          "decide": [
            {
              "if": "a smaller reproduction",
              "then": "bundle"
            }
          ]
        },
        {
          "id": "bisect",
          "do": "Optional: find the commit that introduced a regression.",
          "cli": [
            "bisect",
            "<RUN>",
            "--good",
            "<REV>",
            "--json"
          ],
          "mcp": {
            "tool": "bisect_run"
          },
          "optional": true,
          "decide": [
            {
              "if": "a first bad commit",
              "then": "drivers"
            }
          ]
        }
      ]
    },
    {
      "id": "add-coverage",
      "title": "Add coverage",
      "when": "Tests pass, and the next question is what they do not exercise.",
      "steps": [
        {
          "id": "run",
          "do": "Run the suite with coverage collection.",
          "cli": [
            "regress",
            "run",
            "--tier",
            "full",
            "--rvfi-trace",
            "--out",
            "<RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_run"
          },
          "decide": [
            {
              "if": "runs complete",
              "then": "functional"
            }
          ]
        },
        {
          "id": "functional",
          "do": "Measure instruction and event coverage from the C2 traces.",
          "cli": [
            "cov",
            "functional",
            "<RUN>",
            "--json",
            "--out",
            "<COV>"
          ],
          "mcp": {
            "tool": "cov_functional"
          },
          "decide": [
            {
              "if": "holes listed",
              "then": "merge"
            }
          ]
        },
        {
          "id": "merge",
          "do": "Merge Verilator coverage into one database.",
          "cli": [
            "cov",
            "merge",
            "<RUN>"
          ],
          "mcp": {
            "tool": "cov_merge"
          },
          "decide": [
            {
              "if": "a database",
              "then": "report"
            }
          ]
        },
        {
          "id": "report",
          "do": "Report RTL holes against Scala source lines.",
          "cli": [
            "cov",
            "report",
            "<COVDB>"
          ],
          "mcp": {
            "tool": "cov_report"
          },
          "decide": [
            {
              "if": "holes",
              "then": "rank"
            }
          ]
        },
        {
          "id": "rank",
          "do": "Rank tests by unique contribution.",
          "cli": [
            "cov",
            "rank",
            "<COVDB>",
            "--json"
          ],
          "mcp": {
            "tool": "cov_rank"
          },
          "decide": [
            {
              "if": "holes remain",
              "then": "closure"
            }
          ]
        },
        {
          "id": "closure",
          "do": "Select generated candidates that close holes, then add them as tests.",
          "cli": [
            "cov",
            "closure",
            "<COVDB>",
            "--candidates",
            "<CANDIDATES>"
          ],
          "mcp": {
            "tool": "cov_closure"
          },
          "decide": [
            {
              "if": "new tests added",
              "then": "run"
            },
            {
              "if": "no candidate closes a hole",
              "then": "done"
            }
          ]
        }
      ]
    },
    {
      "id": "prove-property",
      "title": "Prove a property",
      "when": "A rule must hold for all inputs within a bound, not only for the tests.",
      "steps": [
        {
          "id": "doctor",
          "do": "Check the formal tools.",
          "cli": [
            "formal",
            "doctor",
            "--out",
            "<OUT>",
            "--json"
          ],
          "mcp": {
            "tool": "formal_doctor"
          },
          "decide": [
            {
              "if": "a solver is missing",
              "then": "stop",
              "note": "Install with scripts/install.sh --with-formal."
            },
            {
              "if": "ready",
              "then": "bmc"
            }
          ]
        },
        {
          "id": "bmc",
          "do": "Run bounded model checking on the generated or declared checks.",
          "cli": [
            "formal",
            "bmc",
            "--out",
            "<OUT>",
            "--depth",
            "20",
            "--json"
          ],
          "mcp": {
            "tool": "formal_bmc"
          },
          "decide": [
            {
              "if": "fail",
              "then": "cex"
            },
            {
              "if": "timeout or unknown (exit 3)",
              "then": "stop",
              "note": "Bounded and inconclusive. Not a proof."
            },
            {
              "if": "pass",
              "then": "riscv"
            }
          ]
        },
        {
          "id": "riscv",
          "do": "Optional: run the declared riscv-formal checks.",
          "cli": [
            "formal",
            "riscv",
            "--out",
            "<OUT>",
            "--json"
          ],
          "mcp": {
            "tool": "formal_riscv"
          },
          "optional": true,
          "decide": [
            {
              "if": "fail",
              "then": "cex"
            },
            {
              "if": "pass",
              "then": "done",
              "note": "A bounded pass is not a full ISA proof."
            }
          ]
        },
        {
          "id": "cex",
          "do": "Explain the counterexample and replay it in simulation.",
          "cli": [
            "formal",
            "cex",
            "--result",
            "<OUT>",
            "--out",
            "<CEX>",
            "--json"
          ],
          "mcp": {
            "tool": "formal_cex"
          },
          "decide": [
            {
              "if": "a real design bug",
              "then": "test-fails"
            },
            {
              "if": "an environment assumption is missing",
              "then": "bmc",
              "note": "Add the assumption and say so in the result."
            }
          ]
        }
      ]
    },
    {
      "id": "performance-question",
      "title": "Performance question",
      "when": "The question is cycles, IPC or where a pipeline stalls.",
      "steps": [
        {
          "id": "konata",
          "do": "Run the workload with a Konata pipeline log (adapter option --konata).",
          "manual": true,
          "decide": [
            {
              "if": "a Konata log",
              "then": "report"
            }
          ]
        },
        {
          "id": "report",
          "do": "Report IPC, stalls and the top stall causes.",
          "cli": [
            "perf",
            "<LOG>",
            "--json"
          ],
          "mcp": {
            "tool": "perf_report"
          },
          "decide": [
            {
              "if": "a change to compare",
              "then": "compare"
            },
            {
              "if": "a design-space question",
              "then": "calibrate"
            }
          ]
        },
        {
          "id": "compare",
          "do": "Compare two logs or reports from the same workload.",
          "cli": [
            "perf",
            "compare",
            "<A>",
            "<B>",
            "--json"
          ],
          "mcp": {
            "tool": "perf_compare"
          },
          "decide": [
            {
              "if": "a difference over tolerance",
              "then": "done"
            }
          ]
        },
        {
          "id": "calibrate",
          "do": "Optional: fit the gem5 model to RTL results and explore trends.",
          "cli": [
            "arch",
            "calibrate",
            "--out",
            "<OUT>",
            "--json"
          ],
          "mcp": {
            "tool": "arch_calibrate"
          },
          "optional": true,
          "decide": [
            {
              "if": "a calibrated model",
              "then": "done",
              "note": "Model results show trends. RTL is the truth."
            }
          ]
        }
      ]
    }
  ]
}
