{
  "schema": "rvw.agent-guide/1",
  "conventions": {
    "placeholders": "Angle-bracket values (<ELF>, <RUN>, <REV>) are inputs the agent supplies. Every other argument is literal.",
    "exit_codes": "0 earned result; 1 failure or mismatch; 2 usage or setup error; 3 inconclusive. Never treat 3 as a pass.",
    "stop": "A step ends a workflow with `stop` when its decision says so. Record the command, exit code and log before you stop.",
    "locks": "Heavy runs hold the project lock (core.lock). Do not start a second heavy run of the same core.",
    "integration_guide": "Follow docs/INTEGRATION_GUIDE.md for install, project binding and evidence limits. A scaffold or tool list does not qualify a core. For composed SoCs, use GENERATED/verify.json and supply runtime-classpath.txt and soc.db. Fabric proof rows do not close whole-SoC verification.",
    "verdicts": "Verification tools own verdicts in their stated scope. Run manifests record the inputs and reproduction identities; do not treat exit 3 (inconclusive) as a pass."
  },
  "workflows": [
    {
      "id": "bring-up",
      "title": "New core bring-up",
      "when": "A Spinal core repository has no rvw.toml yet, or `rvw doctor` is not ready.",
      "steps": [
        {
          "id": "doctor",
          "do": "Check the installation and the native tools.",
          "cli": [
            "doctor",
            "--features",
            "sim,riscv-gcc,cosim",
            "--json"
          ],
          "mcp": {
            "tool": "rvw_doctor",
            "arguments": {
              "features": "sim,riscv-gcc,cosim"
            }
          },
          "decide": [
            {
              "if": "exit 1 and a native tool is missing",
              "then": "install"
            },
            {
              "if": "project missing",
              "then": "init-plan"
            },
            {
              "if": "exit 0",
              "then": "regress-list"
            }
          ]
        },
        {
          "id": "install",
          "do": "Inspect the installer actions, then run them without --dry-run.",
          "cli": [
            "doctor",
            "--install",
            "sim,riscv-gcc,cosim",
            "--dry-run",
            "--json"
          ],
          "decide": [
            {
              "if": "the plan is acceptable",
              "then": "doctor"
            }
          ]
        },
        {
          "id": "init-plan",
          "do": "Plan the project files. Read every planned file.",
          "cli": [
            "init",
            "--isa",
            "<ISA>",
            "--wire-build",
            "--dry-run",
            "--json"
          ],
          "decide": [
            {
              "if": "exit 2",
              "then": "stop",
              "note": "Fix the reported input (ISA, sbt project, linker script)."
            },
            {
              "if": "exit 0",
              "then": "init"
            }
          ],
          "mcp": {
            "tool": "init_scaffold",
            "arguments": {
              "isa": "<ISA>",
              "wire_build": true,
              "dry_run": true,
              "out": "<PROJECT>"
            }
          }
        },
        {
          "id": "init",
          "do": "Write rvw.toml, rvw/run.sh and the core playbook. Mapped RV32 req/rsp init with RVFI also writes formal and security bindings. Export fresh RTL with rvw/export-rtl.sh before native consumers.",
          "cli": [
            "init",
            "--isa",
            "<ISA>",
            "--wire-build",
            "--json"
          ],
          "decide": [
            {
              "if": "exit 0",
              "then": "map-adapter"
            }
          ],
          "mcp": {
            "tool": "init_scaffold",
            "arguments": {
              "isa": "<ISA>",
              "wire_build": true,
              "dry_run": false,
              "out": "<PROJECT>"
            }
          }
        },
        {
          "id": "map-adapter",
          "do": "Use init_scaffold with spinal_top, reset_pc, buses and rvfi_prefix for a mapped adapter. Map clock, reset, accepted memory transactions, completion and committed RVFI fields in the core adapter. Follow docs/INTEGRATION_GUIDE.md sections 2 to 4. Review the ISA and memory map. Build a smoke ELF.",
          "manual": true,
          "decide": [
            {
              "if": "the adapter compiles",
              "then": "smoke"
            }
          ]
        },
        {
          "id": "smoke",
          "do": "Build the model and run one ELF through C1.",
          "cli": [
            "doctor",
            "--smoke-elf",
            "<ELF>",
            "--smoke-options",
            "rvfi",
            "--json"
          ],
          "mcp": {
            "tool": "doctor_smoke",
            "arguments": {
              "conformance": false,
              "elf": "<ELF>",
              "options": "rvfi"
            }
          },
          "decide": [
            {
              "if": "smoke run fails",
              "then": "test-fails"
            },
            {
              "if": "smoke run passes",
              "then": "regress-list"
            }
          ]
        },
        {
          "id": "regress-list",
          "do": "List the suites and tests the project declares.",
          "cli": [
            "regress",
            "list",
            "--json"
          ],
          "mcp": {
            "tool": "regress_list",
            "arguments": {}
          },
          "decide": [
            {
              "if": "no tests",
              "then": "stop",
              "note": "Build the test ELFs (AGENT_SETUP.md step 6)."
            },
            {
              "if": "tests listed",
              "then": "quick"
            }
          ]
        },
        {
          "id": "quick",
          "do": "Run the quick tier with C2 traces.",
          "cli": [
            "regress",
            "run",
            "--tier",
            "quick",
            "--rvfi-trace",
            "--out",
            "<RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_run",
            "arguments": {
              "tier": "quick",
              "out": "<RUN>",
              "fresh": false,
              "no_index": false,
              "dry_run": false,
              "seed_base": 1,
              "random_seeds": false,
              "filter": [],
              "rvfi_trace": true,
              "no_cache": false
            }
          },
          "decide": [
            {
              "if": "a test fails",
              "then": "test-fails"
            },
            {
              "if": "all pass",
              "then": "cosim"
            }
          ]
        },
        {
          "id": "cosim",
          "do": "Compare one passing C2 trace with Spike.",
          "cli": [
            "cosim",
            "check",
            "--elf",
            "<ELF>",
            "--trace",
            "<RUN>/rvfi.jsonl",
            "--json"
          ],
          "mcp": {
            "tool": "cosim_check",
            "arguments": {
              "elf": "<ELF>",
              "trace": "<RUN>/rvfi.jsonl",
              "model": "spike",
              "history": 10,
              "strict": false,
              "strict_sync": [],
              "timeout": 120
            }
          },
          "decide": [
            {
              "if": "mismatch",
              "then": "test-fails"
            },
            {
              "if": "match",
              "then": "gate"
            }
          ]
        },
        {
          "id": "gate",
          "do": "Commit the project files, then judge the committed revision.",
          "cli": [
            "regress",
            "gate",
            "--tier",
            "quick",
            "--base-rev",
            "<REV>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_gate",
            "arguments": {
              "tier": "quick",
              "base_rev": "<REV>",
              "allow_missing": false,
              "seed_policy": "auto",
              "seed_base": 1,
              "random_seeds": false,
              "filter": [],
              "rvfi_trace": false,
              "no_cache": false
            }
          },
          "decide": [
            {
              "if": "NOT ACCEPTED on a dirty tree",
              "then": "gate",
              "note": "Commit first. A dirty tree cannot earn accept."
            },
            {
              "if": "inconclusive (exit 3)",
              "then": "stop",
              "note": "Missing evidence. Do not report acceptance."
            },
            {
              "if": "accept",
              "then": "design-db"
            }
          ]
        },
        {
          "id": "design-db",
          "do": "Build the design database for design questions.",
          "cli": [
            "query",
            "build",
            "--json"
          ],
          "mcp": {
            "tool": "query_build_db",
            "arguments": {
              "out": "<OUT>"
            }
          },
          "decide": [
            {
              "if": "exit 0",
              "then": "done"
            }
          ]
        }
      ],
      "profile": "core",
      "tools": [
        "agent_bringup_check",
        "agent_guide",
        "cosim_check",
        "csr_describe",
        "doctor_resolve",
        "doctor_smoke",
        "init_scaffold",
        "job_cancel",
        "job_events",
        "job_list",
        "job_log",
        "job_result",
        "job_status",
        "query_build_db",
        "regress_act4_build",
        "regress_act4_plan",
        "regress_gate",
        "regress_instruction_feed",
        "regress_list",
        "regress_mmu_iommu",
        "regress_mmu_iommu_generate",
        "regress_plan",
        "regress_privilege_build",
        "regress_privilege_check",
        "regress_privilege_reference",
        "regress_riscv_tests_build",
        "regress_run",
        "regress_sail_tests",
        "rvw_doctor",
        "rvw_tools_describe",
        "rvw_tools_load",
        "rvw_tools_search"
      ]
    },
    {
      "id": "test-fails",
      "title": "A test fails",
      "when": "A C1 run or a regression test reports fail, assert, timeout or rvfi_error.",
      "steps": [
        {
          "id": "identity",
          "do": "Check the source revision, RTL hash, ELF hash, config and seed of the failing run and each cited artifact. Reject stale waves, wrong ELFs and incomplete runs before cause analysis.",
          "manual": true,
          "decide": [
            {
              "if": "identities match and the failure is reproduced",
              "then": "bundle"
            },
            {
              "if": "evidence is missing or inconsistent",
              "then": "stop",
              "note": "Record the missing evidence. Do not claim a cause or fix."
            }
          ]
        },
        {
          "id": "bundle",
          "do": "Write the failure report from the failed run directory.",
          "cli": [
            "bundle",
            "<RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "bundle_make"
          },
          "decide": [
            {
              "if": "the bundle has a C2 trace",
              "then": "cosim"
            },
            {
              "if": "no C2 trace",
              "then": "stop",
              "note": "Rerun the test with --rvfi-trace."
            }
          ]
        },
        {
          "id": "cosim",
          "do": "Find the first instruction where the core and Spike differ.",
          "cli": [
            "cosim",
            "check",
            "--elf",
            "<ELF>",
            "--trace",
            "<RUN>/rvfi.jsonl",
            "--json"
          ],
          "mcp": {
            "tool": "cosim_check"
          },
          "decide": [
            {
              "if": "mismatch at a retirement",
              "then": "drivers"
            },
            {
              "if": "match but the run failed",
              "then": "wave",
              "note": "The failure is not architectural: look at the end condition, hang or assertion."
            }
          ]
        },
        {
          "id": "drivers",
          "do": "Ask what drives the wrong register or signal.",
          "cli": [
            "query",
            "drivers",
            "<SIGNAL>",
            "--json"
          ],
          "mcp": {
            "tool": "query_drivers"
          },
          "decide": [
            {
              "if": "the driver logic is clear",
              "then": "wave"
            }
          ]
        },
        {
          "id": "wave",
          "do": "Explain the wrong value at the failing cycle.",
          "cli": [
            "wave",
            "why",
            "<WAVE>",
            "<SIGNAL>",
            "--at",
            "<TIME>",
            "--json"
          ],
          "mcp": {
            "tool": "wave_why"
          },
          "decide": [
            {
              "if": "the cause is a Scala statement",
              "then": "fix"
            },
            {
              "if": "no observed statement explains the value",
              "then": "stop",
              "note": "Keep the cause unknown. Static drivers alone do not prove a dynamic cause."
            }
          ]
        },
        {
          "id": "fix",
          "do": "Edit the core. Keep the change small. Do not edit the workstation.",
          "manual": true,
          "decide": [
            {
              "if": "edited",
              "then": "reproduce"
            }
          ]
        },
        {
          "id": "reproduce",
          "do": "Rerun the failing test and the required passing tests with the repair. Use a new output directory. Keep all results.",
          "cli": [
            "regress",
            "run",
            "--tier",
            "quick",
            "--rvfi-trace",
            "--out",
            "<REPAIRED_RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_run"
          },
          "decide": [
            {
              "if": "the failing test passes and the required passing tests stay passing",
              "then": "gate"
            },
            {
              "if": "a test fails",
              "then": "bundle"
            },
            {
              "if": "coverage is incomplete",
              "then": "stop",
              "note": "Do not report a repair."
            }
          ]
        },
        {
          "id": "gate",
          "do": "Judge the fix on the committed revision.",
          "cli": [
            "regress",
            "gate",
            "--tier",
            "quick",
            "--base-rev",
            "<REV>",
            "--json"
          ],
          "mcp": {
            "tool": "regress_gate"
          },
          "decide": [
            {
              "if": "reject",
              "then": "bundle"
            },
            {
              "if": "inconclusive (exit 3)",
              "then": "stop",
              "note": "Do not claim a fix."
            },
            {
              "if": "accept",
              "then": "done"
            }
          ]
        },
        {
          "id": "reduce",
          "do": "Optional: shrink a long failing program before debugging.",
          "cli": [
            "reduce",
            "<RUN>",
            "--json"
          ],
          "mcp": {
            "tool": "reduce_run"
          },
          "optional": true,
          "decide": [
            {
              "if": "a smaller reproduction",
              "then": "bundle"
            }
          ]
        },
        {
          "id": "bisect",
          "do": "Optional: find the commit that introduced a regression.",
          "cli": [
            "bisect",
            "<RUN>",
            "--good",
            "<REV>",
            "--json"
          ],
          "mcp": {
            "tool": "bisect_run"
          },
          "optional": true,
          "decide": [
            {
              "if": "a first bad commit",
              "then": "drivers"
            }
          ]
        }
      ],
      "profile": "debug",
      "tools": [
        "bisect_run",
        "bundle_make",
        "cosim_adjudicate",
        "cosim_doctor",
        "cosim_exchange",
        "cosim_generate",
        "cosim_qemu_check",
        "cosim_vector_source",
        "debug_checks",
        "debug_ingress_check",
        "debug_interop",
        "debug_state_compare",
        "debug_suite",
        "debug_tap",
        "fault_report",
        "fault_run",
        "fault_sites",
        "lsp_request",
        "query_build_hdl",
        "query_component",
        "query_definition",
        "query_diff",
        "query_drivers",
        "query_explain",
        "query_explain_module",
        "query_export",
        "query_fanin",
        "query_fanout",
        "query_hierarchy",
        "query_hierarchy_diff",
        "query_info",
        "query_loads",
        "query_navigate",
        "query_parameters",
        "query_path",
        "query_port_status",
        "query_references",
        "query_regs",
        "query_search",
        "query_type",
        "query_where",
        "reduce_run",
        "regress_compare",
        "regress_cosim",
        "regress_history",
        "regress_known_add",
        "regress_known_list",
        "regress_known_remove",
        "replay_pack",
        "replay_run",
        "wave_bench",
        "wave_changes",
        "wave_cut",
        "wave_diff",
        "wave_edges",
        "wave_find",
        "wave_index",
        "wave_index_verify",
        "wave_info",
        "wave_list",
        "wave_profile",
        "wave_sample",
        "wave_seq",
        "wave_session_open",
        "wave_session_save",
        "wave_txn",
        "wave_value",
        "wave_why",
        "wave_why_run"
      ]
    },
    {
      "id": "prove-property",
      "title": "Prove a property",
      "when": "A hardware property, X-propagation check, or bounded counterexample replay must be checked cleanly.",
      "steps": [
        {
          "id": "doctor",
          "do": "Check formal tool availability.",
          "cli": [
            "doctor",
            "--features",
            "formal",
            "--json"
          ],
          "mcp": {
            "tool": "rvw_doctor",
            "args": {
              "features": [
                "formal"
              ]
            }
          },
          "decide": [
            {
              "if": "a solver is missing",
              "then": "stop",
              "note": "Install with scripts/install.sh --with-formal."
            },
            {
              "if": "ready",
              "then": "xprop"
            }
          ]
        },
        {
          "id": "xprop",
          "do": "Check RTL X-propagation on the declared formal target.",
          "cli": [
            "formal",
            "xprop",
            "--out",
            "<OUT>",
            "--depth",
            "10",
            "--json"
          ],
          "mcp": {
            "tool": "formal_xprop",
            "args": {
              "out": "<OUT>",
              "depth": 10
            }
          },
          "decide": [
            {
              "if": "fail",
              "then": "test-fails",
              "note": "Unexpected unknown value propagated."
            },
            {
              "if": "timeout or unknown (exit 3)",
              "then": "stop",
              "note": "Inconclusive."
            },
            {
              "if": "pass",
              "then": "bmc"
            }
          ]
        },
        {
          "id": "bmc",
          "do": "Run bounded model checking on the generated or declared checks.",
          "cli": [
            "formal",
            "bmc",
            "--out",
            "<OUT>",
            "--depth",
            "20",
            "--json"
          ],
          "mcp": {
            "tool": "formal_bmc",
            "args": {
              "out": "<OUT>",
              "depth": 20
            }
          },
          "decide": [
            {
              "if": "fail",
              "then": "test-fails",
              "note": "Inspect counterexample in wave or sim."
            },
            {
              "if": "timeout or unknown (exit 3)",
              "then": "stop",
              "note": "Bounded and inconclusive. Not a proof."
            },
            {
              "if": "pass",
              "then": "from-sim"
            }
          ]
        },
        {
          "id": "from-sim",
          "optional": true,
          "do": "Optional: seed formal BMC from a captured simulation cycle in VCD/FST.",
          "cli": [
            "formal",
            "from-sim",
            "--trace",
            "<VCD>",
            "--cycle",
            "100",
            "--out",
            "<OUT>",
            "--depth",
            "10",
            "--json"
          ],
          "mcp": {
            "tool": "formal_from_sim",
            "args": {
              "trace": "<VCD>",
              "cycle": 100,
              "out": "<OUT>",
              "depth": 10
            }
          },
          "decide": [
            {
              "if": "fail",
              "then": "test-fails"
            },
            {
              "if": "pass",
              "then": "done",
              "note": "Bounded pass from sampled state."
            }
          ]
        }
      ],
      "profile": "formal",
      "tools": [
        "checks_generate",
        "checks_plan",
        "checks_report",
        "formal_bmc",
        "formal_from_sim",
        "formal_x_context",
        "formal_x_sweep",
        "formal_xprop"
      ]
    },
    {
      "id": "performance-question",
      "title": "Performance question",
      "when": "The question is cycles, IPC or where a pipeline stalls.",
      "steps": [
        {
          "id": "konata",
          "do": "Run the workload with a Konata pipeline log (adapter option --konata). The mapped adapter collects declared probes and converts them. Compare retirement counts with C1 and C2.",
          "manual": true,
          "decide": [
            {
              "if": "a Konata log",
              "then": "report"
            }
          ]
        },
        {
          "id": "report",
          "do": "Report IPC, stalls and the top stall causes.",
          "cli": [
            "perf",
            "<LOG>",
            "--json"
          ],
          "mcp": {
            "tool": "perf_report"
          },
          "decide": [
            {
              "if": "a change to compare",
              "then": "compare"
            },
            {
              "if": "a design-space question",
              "then": "calibrate"
            }
          ]
        },
        {
          "id": "compare",
          "do": "Compare two logs or reports from the same workload.",
          "cli": [
            "perf",
            "compare",
            "<A>",
            "<B>",
            "--json"
          ],
          "mcp": {
            "tool": "perf_compare"
          },
          "decide": [
            {
              "if": "a difference over tolerance",
              "then": "done"
            }
          ]
        },
        {
          "id": "calibrate",
          "do": "Optional: fit the gem5 model to RTL results and explore trends.",
          "cli": [
            "arch",
            "calibrate",
            "--out",
            "<OUT>",
            "--json"
          ],
          "mcp": {
            "tool": "arch_calibrate"
          },
          "optional": true,
          "decide": [
            {
              "if": "a calibrated model",
              "then": "done",
              "note": "Model results show trends. RTL is the truth."
            }
          ]
        }
      ],
