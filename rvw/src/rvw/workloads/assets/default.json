  "workloads": [
    {
      "id": "crc32",
      "mode": "bare",
      "coverage": "integer shifts, data-dependent branches, small streaming input",
      "inputs": "upstream embedded constants; CPU_MHZ=1; no warmup",
      "expected": "upstream verify_benchmark(result) == 1; HTIF exit 0; empty stdout",
      "stdout_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "args": [],
      "build": [
        "{cc}",
        "-ffile-prefix-map={source}=embench",
        "-ffile-prefix-map={assets}=rvw-workload-runtime",
        "-O2",
        "-g0",
        "-march=rv64gc",
        "-mabi=lp64d",
        "-mcmodel=medany",
        "-fno-common",
        "-fno-builtin",
        "-ffp-contract=off",
        "-DCPU_MHZ=1",
        "-ffunction-sections",
        "-fdata-sections",
        "-I{source}/support",
        "-I{source}/src/crc32",
        "{source}/src/crc32/crc_32.c",
        "{source}/support/beebsc.c",
        "{assets}/main.c",
        "{assets}/start.S",
        "-nostartfiles",
        "--specs=nosys.specs",
        "-T{assets}/link.ld",
        "-Wl,--gc-sections",
        "-lm",
        "-o",
        "{out}/workload.elf"
      ]
    },
