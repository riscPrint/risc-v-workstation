[options]
size 24
seed 20261020
tags KILLED SURVIVED
select tiny

[script]
read_verilog -sv tiny.sv
prep -top tiny

[files]
tiny.sv
tb.sv
test_sim.sh

[logic]
if result("low_inputs") == "FAIL":
    tag("KILLED")
else:
    tag("SURVIVED")

[test low_inputs]
expect PASS FAIL
run bash $PRJDIR/test_sim.sh

[report]
print("killed=%d survived=%d" % (tags("KILLED"), tags("SURVIVED")))
