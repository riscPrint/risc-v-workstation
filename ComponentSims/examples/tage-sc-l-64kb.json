{
  "schema": "rvw.csim-study/1",
  "name": "tage-sc-l-64kb",
  "description": "csim TAGE-SC-L sized after the CBP-5 2016 64 KB configuration (18 history lengths 6..3000, 8 Ki-entry bimodal, 1-bit u, 2 allocations, 32-entry loop predictor), about 64 KiB.",
  "source": {
    "fidelity": "approximate",
    "approximations": [
      "csim uses one table per history length; the reference uses two bank-interleaved shared tables with partial associativity",
      "tag widths grow linearly from 8 to 12 bits; the reference uses 8 and 12",
      "the statistical corrector has bias, 4 global and 4 local GEHL tables; the reference adds IMLI, path and three local histories",
      "bimodal hysteresis is not shared between entries"
    ]
  },
  "branch": {
    "model": "tage-sc-l",
    "base_entries": 8192,
    "u_bits": 1,
    "max_alloc": 2,
