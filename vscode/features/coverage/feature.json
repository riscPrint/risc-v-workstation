{
  "id": "coverage",
  "title": "Coverage",
  "description": "Show saved rvw coverage results.",
  "activationEvents": [
    "onCommand:coverage.open",
    "onView:coverage.results",
    "onCommand:coverage.decorate",
    "onCommand:coverage.holes",
    "onCommand:coverage.plan",
    "onCommand:coverage.clearLines"
  ],
  "contributes": {
    "commands": [
      {
        "command": "coverage.open",
        "title": "Coverage: Open Report"
      },
      {
        "command": "coverage.refresh",
        "title": "Coverage: Refresh Report"
      },
      {
        "command": "coverage.raw",
        "title": "Coverage: Open Raw Report"
      },
      {
        "command": "coverage.source",
        "title": "Coverage: Jump to Source via Design Database"
      },
      {
        "command": "coverage.wave",
        "title": "Coverage: Open Waveform in Surfer"
      },
      {
        "command": "coverage.trace",
        "title": "Coverage: Open SpinalTrace"
      },
      {
        "command": "coverage.evidence",
        "title": "Coverage: Open Selected Evidence"
      },
      {
        "command": "coverage.decorate",
        "title": "Coverage: Decorate Scala Lines"
      },
      {
        "command": "coverage.holes",
        "title": "Coverage: Open Functional Coverage Holes"
      },
      {
        "command": "coverage.plan",
        "title": "Coverage: Open Verification Plan Status"
      },
      {
        "command": "coverage.clearLines",
        "title": "Coverage: Clear Line Decorations"
      }
    ],
    "views": {
      "workstation.container": [
        {
          "id": "coverage.results",
          "name": "RVW Coverage"
        },
        {
          "id": "coverage.holes",
          "name": "RVW Coverage Holes and Plan"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "coverage.open",
          "when": "view == coverage.results",
          "group": "navigation"
        },
        {
          "command": "coverage.refresh",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.raw",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.source",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.wave",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.trace",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.decorate",
          "when": "view == coverage.holes",
          "group": "navigation"
        },
        {
          "command": "coverage.holes",
          "when": "view == coverage.holes",
          "group": "navigation"
        },
        {
          "command": "coverage.plan",
          "when": "view == coverage.holes",
          "group": "navigation"
        },
        {
          "command": "coverage.clearLines",
          "when": "view == coverage.holes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "coverage.evidence",
          "when": "view == coverage.results",
          "group": "evidence"
        },
        {
          "command": "coverage.source",
          "when": "view == coverage.results && viewItem == rvw.signal",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "properties": {
        "coverage.rvwExecutable": {
          "type": "string",
          "default": "rvw",
          "description": "Path to rvw.",
          "restricted": true
        },
        "coverage.surferExecutable": {
          "type": "string",
          "default": "surfer",
          "description": "Path to Surfer.",
          "restricted": true
        },
        "coverage.spinaltraceExecutable": {
          "type": "string",
          "default": "spinaltrace",
          "description": "Path to the SpinalTrace GUI.",
          "restricted": true
        }
      }
    }
  },
  "tests": {
    "unit": [
      "test/model.test.ts",
      "test/lines.test.ts"
    ]
  }
}
