{
  "id": "lint",
  "title": "Lint",
  "description": "Show rvw lint findings (lint rules, CDC, RDC, SDC intent, native lint) as diagnostics.",
  "activationEvents": [
    "onCommand:lint.run",
    "onCommand:lint.open",
    "onView:lint.rules"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lint.run",
        "title": "Lint: Run rvw lint"
      },
      {
        "command": "lint.rerun",
        "title": "Lint: Run Again"
      },
      {
        "command": "lint.open",
        "title": "Lint: Open Saved Report or SARIF"
      },
      {
        "command": "lint.clear",
        "title": "Lint: Clear Diagnostics"
      },
      {
        "command": "lint.copyWaiver",
        "title": "Lint: Copy Waiver for Finding"
      }
    ],
    "configuration": {
      "properties": {
        "lint.rvwExecutable": {
          "type": "string",
          "default": "rvw",
          "description": "Path to rvw.",
          "restricted": true
        },
        "lint.settings": {
          "type": "string",
          "default": "",
          "description": "Lint settings file (rvw.lint-settings/1), relative to the first workspace folder. Empty: ask.",
          "restricted": true
        },
        "lint.timeoutMs": {
          "type": "number",
          "default": 600000,
          "description": "Timeout for one rvw lint run."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "lint.open",
          "when": "view == lint.rules",
          "group": "navigation"
        },
        {
          "command": "lint.run",
          "when": "view == lint.rules",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lint.copyWaiver",
          "when": "view == lint.rules && viewItem == lint.finding",
          "group": "quickfix"
        }
      ]
    },
    "views": {
      "workstation.container": [
        {
          "id": "lint.rules",
          "name": "RVW Lint, CDC, RDC and SDC"
        }
      ]
    }
  },
  "tests": {
    "unit": [
      "test/model.test.ts",
      "test/groups.test.ts"
    ]
  }
}
