{
  "id": "formal",
  "title": "Formal Properties",
  "description": "Formal Properties saved results.",
  "activationEvents": [
    "onCommand:formal.open",
    "onCommand:formal.child",
    "onCommand:formal.wave",
    "onCommand:formal.highlight",
    "onCommand:formal.clear",
    "onView:formal.results"
  ],
  "contributes": {
    "commands": [
      {
        "command": "formal.open",
        "title": "Formal Properties: Open Saved Formal Result"
      },
      {
        "command": "formal.child",
        "title": "Formal Properties: Open Selected Property Result"
      },
      {
        "command": "formal.wave",
        "title": "Formal Properties: Open Counterexample Wave"
      },
      {
        "command": "formal.highlight",
        "title": "Formal Properties: Highlight Saved Proof Core"
      },
      {
        "command": "formal.clear",
        "title": "Formal Properties: Clear Proof Core"
      }
    ],
    "views": {
      "workstation.container": [
        {
          "id": "formal.results",
          "name": "RVW Formal Properties"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "formal.open",
          "when": "view == formal.results",
          "group": "navigation"
        },
        {
          "command": "formal.child",
          "when": "view == formal.results",
          "group": "navigation"
        },
        {
          "command": "formal.wave",
          "when": "view == formal.results",
          "group": "navigation"
        },
        {
          "command": "formal.highlight",
          "when": "view == formal.results",
          "group": "navigation"
        },
        {
          "command": "formal.clear",
          "when": "view == formal.results",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "formal.child",
          "when": "view == formal.results",
          "group": "navigation"
        },
        {
          "command": "formal.wave",
          "when": "view == formal.results",
          "group": "navigation"
        }
      ]
    }
  },
  "tests": {
    "unit": [
      "test/model.test.ts"
    ]
  }
}
