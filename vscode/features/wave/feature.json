{
  "id": "wave",
  "title": "Wave queries",
  "description": "Run and save rvw wave queries: expression search, driver traces, sequences, transactions and wave diffs.",
  "activationEvents": ["onCommand:wave.new", "onCommand:wave.open", "onView:wave.results"],
  "contributes": {
    "commands": [
      {"command": "wave.new", "title": "Wave: New Query"},
      {"command": "wave.open", "title": "Wave: Open Saved Query"},
      {"command": "wave.rerun", "title": "Wave: Run Query Again"},
      {"command": "wave.save", "title": "Wave: Save Query"},
      {"command": "wave.raw", "title": "Wave: Open Result JSON"},
      {"command": "wave.driverSource", "title": "Wave: Open Driver Location"},
      {"command": "wave.signalSource", "title": "Wave: Jump to Signal Source via Design Database"},
      {"command": "wave.openWindow", "title": "Wave: Open Window in Surfer"}
    ],
    "views": {"explorer": [{"id": "wave.results", "name": "RVW Wave Query"}]},
    "menus": {
      "view/title": [
        {"command": "wave.new", "when": "view == wave.results", "group": "navigation"},
        {"command": "wave.open", "when": "view == wave.results", "group": "navigation"},
        {"command": "wave.rerun", "when": "view == wave.results", "group": "results"},
        {"command": "wave.save", "when": "view == wave.results", "group": "results"},
        {"command": "wave.raw", "when": "view == wave.results", "group": "results"}
      ],
      "view/item/context": [
        {"command": "wave.raw", "when": "view == wave.results", "group": "evidence"},
        {"command": "wave.driverSource", "when": "view == wave.results && viewItem =~ /loc/", "group": "navigation"},
        {"command": "wave.signalSource", "when": "view == wave.results && viewItem =~ /signal/", "group": "navigation"},
        {"command": "wave.openWindow", "when": "view == wave.results && viewItem =~ /time/", "group": "navigation"}
      ]
    },
    "configuration": {
      "properties": {
        "wave.rvwExecutable": {"type": "string", "default": "rvw", "description": "Path to rvw.", "restricted": true},
        "wave.surferExecutable": {"type": "string", "default": "surfer", "description": "Path to Surfer (or SpinalWaves).", "restricted": true},
        "wave.windowSpan": {"type": "number", "default": 1000, "description": "Wave time before and after a selected row for Open Window in Surfer."},
        "wave.timeoutMs": {"type": "number", "default": 600000, "description": "Time limit for one rvw call."}
      }
    }
  },
  "tests": {"unit": ["test/model.test.ts"]}
}
