{
  "name": "risc-v-workstation",
  "displayName": "RISC-V Workstation",
  "description": "Tools for RISC-V and SpinalHDL hardware development: block diagrams, saved regression, coverage and performance views.",
  "version": "0.1.0",
  "publisher": "riscprint",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/riscPrint/risc-v-workstation.git",
    "directory": "vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:coverage.open",
    "onView:coverage.results",
    "onCommand:debug.open",
    "onCommand:lint.run",
    "onCommand:lint.open",
    "onCommand:perf.open",
    "onView:perf.results",
    "onCommand:regress.open",
    "onView:regress.results",
    "onCustomEditor:spinalblocks.diagram",
    "onLanguage:scala",
    "workspaceContains:**/blocks/*.json.gz",
    "workspaceContains:**/*.spinalblocks.json",
    "onCommand:wave.new",
    "onCommand:wave.open",
    "onView:wave.results",
    "onCommand:wave.openSession"
  ],
  "contributes": {
    "commands": [
      {
        "command": "coverage.open",
        "title": "Coverage: Open Report"
      },
      {
        "command": "coverage.refresh",
        "title": "Coverage: Refresh Report"
      },
      {
        "command": "coverage.raw",
        "title": "Coverage: Open Raw Report"
      },
      {
        "command": "coverage.source",
        "title": "Coverage: Jump to Source via Design Database"
      },
      {
        "command": "coverage.wave",
        "title": "Coverage: Open Waveform in Surfer"
      },
      {
        "command": "coverage.trace",
        "title": "Coverage: Open SpinalTrace"
      },
      {
        "command": "coverage.evidence",
        "title": "Coverage: Open Selected Evidence"
      },
      {
        "command": "debug.open",
        "title": "Debug: Open Integrated Session"
      },
      {
        "command": "lint.run",
        "title": "Lint: Run rvw lint"
      },
      {
        "command": "lint.rerun",
        "title": "Lint: Run Again"
      },
      {
        "command": "lint.open",
        "title": "Lint: Open Saved Report or SARIF"
      },
      {
        "command": "lint.clear",
        "title": "Lint: Clear Diagnostics"
      },
      {
        "command": "perf.open",
        "title": "Performance: Open Report"
      },
      {
        "command": "perf.refresh",
        "title": "Performance: Refresh Report"
      },
      {
        "command": "perf.raw",
        "title": "Performance: Open Raw Report"
      },
      {
        "command": "perf.source",
        "title": "Performance: Jump to Source via Design Database"
      },
      {
        "command": "perf.wave",
        "title": "Performance: Open Waveform in Surfer"
      },
      {
        "command": "perf.trace",
        "title": "Performance: Open SpinalTrace"
      },
      {
        "command": "perf.evidence",
        "title": "Performance: Open Selected Evidence"
      },
      {
        "command": "regress.open",
        "title": "Regression: Open Report"
      },
      {
        "command": "regress.refresh",
        "title": "Regression: Refresh Report"
      },
      {
        "command": "regress.raw",
        "title": "Regression: Open Raw Report"
      },
      {
        "command": "regress.source",
        "title": "Regression: Jump to Source via Design Database"
      },
      {
        "command": "regress.wave",
        "title": "Regression: Open Waveform in Surfer"
      },
      {
        "command": "regress.trace",
        "title": "Regression: Open SpinalTrace"
      },
      {
        "command": "regress.evidence",
        "title": "Regression: Open Selected Evidence"
      },
      {
        "command": "regress.runResult",
        "title": "Regression: Open Declared C1 Run Result"
      },
      {
        "command": "spinalblocks.open",
        "title": "SpinalBlocks: Open Block Diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "spinalblocks.find",
        "title": "SpinalBlocks: Find in Diagram"
      },
      {
        "command": "spinalblocks.navigate",
        "title": "SpinalBlocks: Navigate to Instance"
      },
      {
        "command": "spinalblocks.showLocation",
        "title": "SpinalBlocks: Show in Block Diagram"
      },
      {
        "command": "spinalblocks.openFsm",
        "title": "SpinalBlocks: Open State Machines Diagram"
      },
      {
        "command": "spinalblocks.showFsmLocation",
        "title": "SpinalBlocks: Show in State Machines Diagram"
      },
      {
        "command": "spinalblocks.forgetDesignChoice",
        "title": "SpinalBlocks: Forget Remembered Design Choices"
      },
      {
        "command": "wave.new",
        "title": "Wave: New Query"
      },
      {
        "command": "wave.open",
        "title": "Wave: Open Saved Query"
      },
      {
        "command": "wave.rerun",
        "title": "Wave: Run Query Again"
      },
      {
        "command": "wave.save",
        "title": "Wave: Save Query"
      },
      {
        "command": "wave.raw",
        "title": "Wave: Open Result JSON"
      },
      {
        "command": "wave.driverSource",
        "title": "Wave: Open Driver Location"
      },
      {
        "command": "wave.signalSource",
        "title": "Wave: Jump to Signal Source via Design Database"
      },
      {
        "command": "wave.openWindow",
        "title": "Wave: Open Window in Surfer"
      },
      {
        "command": "wave.openSession",
        "title": "Wave: Open Debug Session"
      },
      {
        "command": "wave.runSaved",
        "title": "Wave: Run Saved Query"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "coverage.results",
          "name": "RVW Coverage"
        },
        {
          "id": "perf.results",
          "name": "RVW Performance"
        },
        {
          "id": "regress.results",
          "name": "RVW Regression"
        },
        {
          "id": "spinalblocks.hierarchy",
          "name": "SpinalBlocks",
          "when": "spinalblocks.hasDiagram"
        },
        {
          "id": "wave.results",
          "name": "RVW Wave Query"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "coverage.open",
          "when": "view == coverage.results",
          "group": "navigation"
        },
        {
          "command": "coverage.refresh",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.raw",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.source",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.wave",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "coverage.trace",
          "when": "view == coverage.results",
          "group": "results"
        },
        {
          "command": "perf.open",
          "when": "view == perf.results",
          "group": "navigation"
        },
        {
          "command": "perf.refresh",
          "when": "view == perf.results",
          "group": "results"
        },
        {
          "command": "perf.raw",
          "when": "view == perf.results",
          "group": "results"
        },
        {
          "command": "perf.source",
          "when": "view == perf.results",
          "group": "results"
        },
        {
          "command": "perf.wave",
          "when": "view == perf.results",
          "group": "results"
        },
        {
          "command": "perf.trace",
          "when": "view == perf.results",
          "group": "results"
        },
        {
          "command": "regress.open",
          "when": "view == regress.results",
          "group": "navigation"
        },
        {
          "command": "regress.refresh",
          "when": "view == regress.results",
          "group": "results"
        },
        {
          "command": "regress.raw",
          "when": "view == regress.results",
          "group": "results"
        },
        {
          "command": "regress.source",
          "when": "view == regress.results",
          "group": "results"
        },
        {
          "command": "regress.wave",
          "when": "view == regress.results",
          "group": "results"
        },
        {
          "command": "regress.trace",
          "when": "view == regress.results",
          "group": "results"
        },
        {
          "command": "wave.new",
          "when": "view == wave.results",
          "group": "navigation"
        },
        {
          "command": "wave.open",
          "when": "view == wave.results",
          "group": "navigation"
        },
        {
          "command": "wave.openSession",
          "when": "view == wave.results",
          "group": "navigation"
        },
        {
          "command": "wave.rerun",
          "when": "view == wave.results",
          "group": "results"
        },
        {
          "command": "wave.save",
          "when": "view == wave.results",
          "group": "results"
        },
        {
          "command": "wave.raw",
          "when": "view == wave.results",
          "group": "results"
        }
      ],
      "view/item/context": [
        {
          "command": "coverage.evidence",
          "when": "view == coverage.results",
          "group": "evidence"
        },
        {
          "command": "coverage.source",
          "when": "view == coverage.results && viewItem == rvw.signal",
          "group": "navigation"
        },
        {
          "command": "perf.evidence",
          "when": "view == perf.results",
          "group": "evidence"
        },
        {
          "command": "perf.source",
          "when": "view == perf.results && viewItem == rvw.signal",
          "group": "navigation"
        },
        {
          "command": "regress.evidence",
          "when": "view == regress.results",
          "group": "evidence"
        },
        {
          "command": "regress.source",
          "when": "view == regress.results && viewItem == rvw.signal",
          "group": "navigation"
        },
        {
          "command": "regress.runResult",
          "when": "view == regress.results && viewItem == rvw.run",
          "group": "navigation"
        },
        {
          "command": "wave.raw",
          "when": "view == wave.results",
          "group": "evidence"
        },
        {
          "command": "wave.driverSource",
          "when": "view == wave.results && viewItem =~ /loc/",
          "group": "navigation"
        },
        {
          "command": "wave.signalSource",
          "when": "view == wave.results && viewItem =~ /signal/",
          "group": "navigation"
        },
        {
          "command": "wave.openWindow",
          "when": "view == wave.results && viewItem =~ /time/",
          "group": "navigation"
        },
        {
          "command": "wave.runSaved",
          "when": "view == wave.results && viewItem =~ /query/",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "spinalblocks.open",
          "group": "navigation",
          "when": "resourceExtname == .json || resourceExtname == .gz"
        }
      ],
      "editor/title": [
        {
          "command": "spinalblocks.open",
          "when": "resourceExtname == .scala",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "spinalblocks.showLocation",
          "when": "resourceExtname == .scala",
          "group": "navigation@10"
        },
        {
          "command": "spinalblocks.showFsmLocation",
          "when": "resourceExtname == .scala",
          "group": "navigation@10"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "spinalblocks.diagram",
        "displayName": "SpinalBlocks Diagram",
        "selector": [
          {
            "filenamePattern": "*.spinalblocks.json"
          },
          {
            "filenamePattern": "*.json.gz"
          },
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "spinalblocks.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == spinalblocks.diagram"
      }
    ],
    "languages": [
      {
        "id": "scala",
        "aliases": [
          "Scala",
          "scala"
        ],
        "extensions": [
          ".scala"
        ]
      }
    ],
    "configuration": [
      {
        "title": "Coverage",
        "properties": {
          "coverage.rvwExecutable": {
            "type": "string",
            "default": "rvw",
            "description": "Path to rvw.",
            "restricted": true
          },
          "coverage.surferExecutable": {
            "type": "string",
            "default": "surfer",
            "description": "Path to Surfer.",
            "restricted": true
          },
          "coverage.spinaltraceExecutable": {
            "type": "string",
            "default": "spinaltrace",
            "description": "Path to the SpinalTrace GUI.",
            "restricted": true
          }
        }
      },
      {
        "title": "Integrated debug",
        "properties": {
          "debug.python": {
            "type": "string",
            "default": "python3",
            "description": "Python executable for the local debug backend.",
            "restricted": true
          },
          "debug.rvwSource": {
            "type": "string",
            "default": "",
            "description": "Path to rvw/src for the local debug backend.",
            "restricted": true
          }
        }
      },
      {
        "title": "Lint",
        "properties": {
          "lint.rvwExecutable": {
            "type": "string",
            "default": "rvw",
            "description": "Path to rvw.",
            "restricted": true
          },
          "lint.settings": {
            "type": "string",
            "default": "",
            "description": "Lint settings file (rvw.lint-settings/1), relative to the first workspace folder. Empty: ask.",
            "restricted": true
          },
          "lint.timeoutMs": {
            "type": "number",
            "default": 600000,
            "description": "Timeout for one rvw lint run."
          }
        }
      },
      {
        "title": "Performance",
        "properties": {
          "perf.rvwExecutable": {
            "type": "string",
            "default": "rvw",
            "description": "Path to rvw.",
            "restricted": true
          },
          "perf.surferExecutable": {
            "type": "string",
            "default": "surfer",
            "description": "Path to Surfer.",
            "restricted": true
          },
          "perf.spinaltraceExecutable": {
            "type": "string",
            "default": "spinaltrace",
            "description": "Path to the SpinalTrace GUI.",
            "restricted": true
          }
        }
      },
      {
        "title": "Regression",
        "properties": {
          "regress.rvwExecutable": {
            "type": "string",
            "default": "rvw",
            "description": "Path to rvw.",
            "restricted": true
          },
          "regress.surferExecutable": {
            "type": "string",
            "default": "surfer",
            "description": "Path to Surfer.",
            "restricted": true
          },
          "regress.spinaltraceExecutable": {
            "type": "string",
            "default": "spinaltrace",
            "description": "Path to the SpinalTrace GUI.",
            "restricted": true
          }
        }
      },
      {
        "title": "SpinalBlocks",
        "properties": {
          "spinalblocks.designFiles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "**/blocks/*.json.gz",
              "**/*.spinalblocks.json"
            ],
            "description": "Workspace globs for generated SpinalBlocks design files."
          },
          "spinalblocks.followCursor": {
            "type": "boolean",
            "default": false,
            "description": "Select the matching element in visible diagrams when the Scala editor cursor moves."
          }
        }
      },
      {
        "title": "Wave queries",
        "properties": {
          "wave.rvwExecutable": {
            "type": "string",
            "default": "rvw",
            "description": "Path to rvw.",
            "restricted": true
          },
          "wave.surferExecutable": {
            "type": "string",
            "default": "surfer",
            "description": "Path to Surfer (or SpinalWaves).",
            "restricted": true
          },
          "wave.windowSpan": {
            "type": "number",
            "default": 1000,
            "description": "Wave time before and after a selected row for Open Window in Surfer."
          },
          "wave.timeoutMs": {
            "type": "number",
            "default": 600000,
            "description": "Time limit for one rvw call."
          }
        }
      }
    ]
  },
  "scripts": {
    "manifest": "node scripts/manifest.mjs",
    "manifest:check": "node scripts/manifest.mjs --check",
    "build": "node scripts/manifest.mjs && node build.mjs",
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run manifest:check && node --test \"dist/*/test/*.test.js\"",
    "test:integration:spinalblocks": "node features/spinalblocks/test/run.cjs",
    "package": "vsce package",
    "test:integration:debug": "node features/debug/test/browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "elkjs": "0.12.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.56.0",
    "typescript": "^5.6.0"
  }
}
