{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode"
    ],
    "paths": {
      "elkjs/*": [
        "./node_modules/elkjs/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "features/*/src/**/*.ts",
    "features/*/test/**/*.ts"
  ]
}
